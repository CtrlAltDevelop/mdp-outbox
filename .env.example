# Copy to .env; docker compose and `mdp` both read it. Every setting has a
# default, so an empty .env runs the synthetic demo.

# Which feed `mdp ingest` follows: synthetic | binance | kraken | engine
MDP_SOURCE=synthetic
# Canonical symbols, BASE-QUOTE. Binance: BTC-USDT. Kraken: BTC-USD.
MDP_SYMBOLS=BTC-USDT,ETH-USDT

# Only outside docker compose, which sets these itself.
# MDP_REDIS_URL=redis://localhost:6379/0
# MDP_DATABASE_URL=postgresql://mdp:mdp@localhost:5432/mdp

# Synthetic source
MDP_SYNTHETIC_RATE=20
MDP_SYNTHETIC_SEED=7

# Matching engine: ws://host/path, or redis://host:6379/0#stream-key
# MDP_ENGINE_URL=redis://engine-redis:6379/0#engine:trades
# MDP_ENGINE_PRICE_SCALE=2
# MDP_ENGINE_QTY_SCALE=8

# Aggregation
MDP_ALLOWED_LATENESS_MS=5000
MDP_IDLE_GRACE_MS=2000

# Gap repair (docker compose --profile repair up)
MDP_REPAIR_SOURCE=binance
MDP_REPAIR_INTERVAL_S=60
MDP_REPAIR_LOOKBACK_MINUTES=1440

# Credentials for the local stack. Change both before exposing it anywhere.
POSTGRES_PASSWORD=mdp
GRAFANA_ADMIN_PASSWORD=admin
